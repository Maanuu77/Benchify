# Copia este fichero a .env (está en .gitignore) y ajusta los valores.
# docker compose lo lee automáticamente; Spring Boot lee las mismas variables del entorno.
# Nunca guardes aquí credenciales reales de producción: en Cloud Run vienen de Secret Manager.

# ── Base de datos ────────────────────────────────────────────────────────────
# Puerto publicado por docker compose (5433 para no chocar con un PostgreSQL local)
DB_PORT=5433
DB_USERNAME=benchify
DB_PASSWORD=benchify
# Perfil dev: por defecto jdbc:postgresql://localhost:5433/benchify
# Perfil prod (Cloud Run + Cloud SQL):
#   jdbc:postgresql:///benchify?cloudSqlInstance=PROYECTO:REGION:INSTANCIA&socketFactory=com.google.cloud.sql.postgres.SocketFactory
DB_URL=

# ── Firebase ─────────────────────────────────────────────────────────────────
# En desarrollo se usa el proyecto de demostración del emulador
FIREBASE_PROJECT_ID=demo-benchify
FIREBASE_STORAGE_BUCKET=demo-benchify.appspot.com
# Emuladores (perfil dev). En Docker el backend usa firebase:9099 / http://firebase:9199
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_URL=http://localhost:9199
# URL del emulador de Storage vista desde el navegador (solo si difiere de la anterior)
FIREBASE_STORAGE_PUBLIC_URL=
# Fuera de Google Cloud y sin emulador: ruta a una clave de cuenta de servicio (no la subas al repo)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Usuarios de ejemplo (solo perfil dev con emulador) ───────────────────────
SEED_ENABLED=true
SEED_USERS_PASSWORD=benchify-dev

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8080
# Orígenes permitidos por CORS en producción, separados por comas
CORS_ALLOWED_ORIGINS=https://benchify-prod.web.app,https://benchify-prod.firebaseapp.com
# Swagger UI y /v3/api-docs en producción
API_DOCS_ENABLED=false

# ── Tests de integración sin Docker (opcional) ───────────────────────────────
# PostgreSQL + PostGIS existente en lugar de Testcontainers
IT_DATABASE_URL=
IT_DATABASE_USERNAME=benchify
IT_DATABASE_PASSWORD=benchify
